# ── Primary model (OpenAI-compatible) ────────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MODEL=
# Optional User-Agent override for all OpenAI-compatible clients.
# Provider-specific *_OPENAI_USER_AGENT values override this default.
OPENAI_USER_AGENT=
# Enable/disable model reasoning traces (thinking) across requests + stream output.
ENABLE_THINKING=true

# ── Primary model (Anthropic Messages API) ───────────────────────────────────
# Set USE_ANTHROPIC=true to route primary requests through Anthropic's Messages API
# instead of an OpenAI-compatible endpoint. When enabled, OPENAI_API_KEY and MODEL
# are not required for the primary provider.
USE_ANTHROPIC=false
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_VERSION=2024-10-22
# Budget tokens for Anthropic extended thinking (≥1024, < max_tokens). Only used when ENABLE_THINKING=true.
ANTHROPIC_THINKING_BUDGET=4096

# ── Memory embeddings ────────────────────────────────────────────────────────
# Used for semantic memory reranking and low-information chatter suppression.
# The sqlite-vec table is fixed at 3072 dimensions; changing dimensions requires
# deleting/rebuilding memory_chunk_vec, memory_prototype_vec, and embedding meta.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=google/gemini-embedding-2-preview
EMBEDDING_DIMENSIONS=3072
EMBEDDING_OPENAI_USER_AGENT=

# Used when the primary endpoint is unreachable or rate-limited (429/5xx).
# Supports any OpenAI-compatible provider (OpenRouter, LM Studio, etc.).
FALLBACK_OPENAI_BASE_URL=http://localhost:1234/v1
FALLBACK_OPENAI_API_KEY=
FALLBACK_MODEL=
# Tool call policy for fallback requests: required, auto, none
FALLBACK_TOOL_CHOICE=required
# Optional headers
FALLBACK_OPENAI_REFERER=
FALLBACK_OPENAI_TITLE=
FALLBACK_OPENAI_USER_AGENT=
# Optional summary provider User-Agent override when SUMMARY_* provider is configured.
SUMMARY_OPENAI_USER_AGENT=
# Context window enforcement for fallback. Defaults to true for localhost, false otherwise.
FALLBACK_ENFORCE_CONTEXT_LIMIT=
FALLBACK_N_CTX=4096
FALLBACK_CONTEXT_MARGIN=256
FALLBACK_HARD_OVERFLOW_TOKENS=1024

# Set to "local" to skip the primary model and route all requests to the fallback.
NIRI_ENV=default

# Display name for the agent, used in the summarizer prompt and grounding context.
# Defaults to "niri" when unset.
# AGENT_NAME=niri
# Stable worker id reported to the control panel.
# NIRI_AGENT_ID=niri

# ── Server / worker topology ─────────────────────────────────────────────────
# `npm start` launches the control plane on PORT/CONTROL_PORT. Configure local
# workers here as a JSON array; see docs/client-server.md for the full shape.
# NIRI_LOCAL_AGENTS_JSON=[{"id":"mira","port":3101,"home":"./data/agents/mira","toolClientToken":"replace-me","expectedClientId":"mira-macbook"}]
# Directly registered remote workers can still use these existing controls:
# NIRI_AGENTS=mira=http://127.0.0.1:3101
# NIRI_AGENTS_JSON=[]
# NIRI_AGENT_URL=
# For the single default local worker spawned by `npm start`.
# NIRI_WORKER_PORT=3001
# NIRI_HOME=./data/agents/niri
# NIRI_AGENT_STATE_DIR=./data/agents/niri/state
# Control-plane database root. Defaults to ./data/control when NIRI_HOME is unset.
# NIRI_CONTROL_HOME=/srv/niri/control
# Loopback is the default bind. Every control plane requires a management token.
# NIRI_CONTROL_HOST=127.0.0.1
NIRI_CONTROL_TOKEN=
# Runtime POST /agents registration is disabled unless this is explicitly true.
NIRI_ALLOW_DYNAMIC_AGENTS=false
# Copy legacy repo-root snapshots into the single default agent on first run.
# Explicit multi-agent entries default this to false unless set in that agent's env.
NIRI_MIGRATE_LEGACY_STATE=true
# Private control-plane -> worker bearer token. The local manager generates one.
# NIRI_WORKER_TOKEN=
# Managed workers always bind to loopback and receive a generated token. Every standalone worker requires one.
# NIRI_WORKER_HOST=127.0.0.1
# Omit Discord tools when the server-side gateway should not be used.
NIRI_DISABLE_DISCORD_TOOLS=false

# ── Client tool pairing ──────────────────────────────────────────────────────
# Required on the worker and the matching local tool daemon. Use a separate long
# random value per agent; the server never falls back to local shell access.
NIRI_TOOL_CLIENT_TOKEN=
# Optional hard binding for exactly one named tool client.
# NIRI_EXPECTED_CLIENT_ID=
# Client daemon settings (set these on the client machine, not the server).
# NIRI_SERVER_URL=https://your-server.example
# NIRI_CLIENT_ID=niri-macbook
# NIRI_CLIENT_WORKSPACE=/absolute/path/to/workspace
# NIRI_CLIENT_HOME=/absolute/path/to/agent-home
# NIRI_CLIENT_CAPABILITIES=shell,read_file,edit_file,image_tool
# NIRI_CLIENT_JOURNAL=/absolute/path/to/tool-invocation-journal.json
# NIRI_CLIENT_STATE_DIR=/absolute/path/to/private/client-state
# Explicit variables to add to the otherwise restricted model-shell environment.
# NIRI_CLIENT_SHELL_ENV_JSON={"PROJECT_MODE":"development"}
# Maximum UTF-8 bytes returned by a client text tool (default 512000).
# NIRI_MAX_RESULT_BYTES=512000
# Set an explicit endpoint only for custom reverse proxies. By default the
# daemon uses /agents/<agentId>/client on the control server.
# NIRI_TOOL_CLIENT_ENDPOINT=
# NIRI_TOOL_CLIENT_DIRECT_WORKER=false

# The Docker container is now an optional client-side executor. Set both values
# on the client daemon to route its shell through docker exec instead; NIRI_USER
# must match the Dockerfile user and NIRI_CLIENT_WORKSPACE must be a path inside
# that container.
# NIRI_USER=niri
# NIRI_CONTAINER=niri
# UID/GID the container process runs as — match your host user to avoid permission issues.
# On Linux this is usually `id -u` / `id -g` (often 1000:1000).
AGENT_UID=1000
AGENT_GID=1000

PORT=3000
# Optional explicit control-plane port; defaults to PORT.
# CONTROL_PORT=3000
# Used by the chat CLI to connect to the control plane. Include the scheme, exclude the port.
NIRI_HOST=http://localhost
# By default `npm run chat` targets NIRI_AGENT_ID through the control plane.
# Set true only when NIRI_HOST:PORT is a direct worker endpoint.
NIRI_CHAT_DIRECT_WORKER=false

# ── Context & token limits ────────────────────────────────────────────────────
CONTEXT_COMPACT_TARGET_TOKENS=65000
CONTEXT_COMPACT_TRIGGER_TOKENS=90000
CONTEXT_COMPACT_RECENT_MESSAGES=80
CONTEXT_COMPACT_CHUNK_MESSAGES=32
CONTEXT_COMPACT_SUMMARY_MAX_CHARS=16000

# ── Runner safety guardrails ──────────────────────────────────────────────────
# Hard cap on assistant turns in a single wake cycle.
RUNNER_MAX_TURNS=120
# Stop if the same assistant tool call + result pattern repeats.
RUNNER_MAX_IDENTICAL_TOOL_TURNS=6

# ── Tools ─────────────────────────────────────────────────────────────────────
# Max bytes accepted by image_tool before rejecting the file.
IMAGE_TOOL_MAX_BYTES=150000
# Override the image directory exposed by the local tool client.
# Default: /home/$NIRI_USER/images with Docker, <client workspace>/home/images otherwise.
IMAGE_ROOT=

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# Optional — auto-detected from the gateway on first connect if left blank.
DISCORD_BOT_USER_ID=
# Comma-separated user IDs. If set, only DMs from these users are ingested/processed.
DISCORD_DM_WHITELIST=
# Enable the built-in gateway listener (messageCreate → ingest pipeline).
DISCORD_GATEWAY_ENABLED=true
# Log every ingest decision (verbose, for debugging).
DISCORD_GATEWAY_TRACE=false
# Also ingest raw MESSAGE_CREATE packets — recommended for DM reliability.
DISCORD_GATEWAY_RAW_FALLBACK=true
# Comma-separated channel IDs scanned by discord_scan when no channel_ids arg is passed.
DISCORD_SCAN_CHANNEL_IDS=
# Wake the agent immediately on any new Discord event (leave false to avoid spam).
DISCORD_WAKE_ON_EVENT=false
# Wake immediately on DMs even when DISCORD_WAKE_ON_EVENT is false.
DISCORD_WAKE_ON_DM=true
# How often to batch pending Discord events into a single harness message.
DISCORD_BATCH_INTERVAL_MS=60000
# Restrict batch digests to configured scan channels + DMs (recommended).
DISCORD_BATCH_ONLY_CONFIGURED=true
# Auto-demote pending inbox items to seen after N minutes (0 = disabled).
DISCORD_PENDING_AUTO_SEEN_MINUTES=10
# Include a channel scan snapshot in each batch payload.
DISCORD_BATCH_SCAN=true
# Max messages included in a single batch digest.
DISCORD_BATCH_MAX_MESSAGES=40
# Cooldown channels: only respond within configured active hours. Outside them,
# messages are still ingested for memory but the agent won't wake or reply.
# Format: flat comma-separated triples of channelId,startHHMM,endHHMM.
# Hours are 24h HHMM; a window may wrap past midnight (start >= end).
# Example: COOLDOWN_CHANNELS=91358921451,1700,2400,91358921452,900,1700
#   -> 91358921451 active 17:00-24:00, 91358921452 active 09:00-17:00
COOLDOWN_CHANNELS=
# IANA timezone for COOLDOWN_CHANNELS hours (e.g. America/New_York).
# Falls back to the server's local timezone when unset.
COOLDOWN_TZ=

# ── Antigravity Bridge ────────────────────────────────────────────────────────
# Set ANTIGRAVITY_BRIDGE_ENABLED=true to run the local Antigravity Bridge server.
# This proxies OpenAI/Anthropic completion requests to daily-cloudcode-pa.googleapis.com
ANTIGRAVITY_BRIDGE_ENABLED=false
# Port to run the bridge server on (defaults to 8000)
ANTIGRAVITY_BRIDGE_PORT=8000
# OAuth client ID and secret (extracted from agy binary if left blank)
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
# OAuth refresh token (extracted from ~/.gemini/antigravity-cli/antigravity-oauth-token if left blank)
ANTIGRAVITY_REFRESH_TOKEN=
# Google Cloud Platform Project ID (fetched automatically if left blank)
ANTIGRAVITY_PROJECT_ID=
# Expected SHA256 of the agy binary (verified if set, read from agy.sha256 if present)
ANTIGRAVITY_EXPECTED_SHA256=
# Path to the agy binary (defaults to ~/.local/bin/agy)
ANTIGRAVITY_BINARY_PATH=
